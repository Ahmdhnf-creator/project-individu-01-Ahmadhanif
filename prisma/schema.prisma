generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  role                Role                 @default(PELANGGAN)
  wa                  String?
  address             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  billingTransactions BillingTransaction[]
  orders              Order[]
  sessions            Session[]
  subscriptions       Subscription[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Int
  unit        String      @default("pcs")
  type        ItemType    @default(BARANG)
  trackStock  Boolean     @default(true)
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  wa        String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id            String        @id @default(cuid())
  customerId    String?
  userId        String?
  status        OrderStatus   @default(BARU)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(BELUM_BAYAR)
  proofUrl      String?
  total         Int           @default(0)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer?     @relation(fields: [customerId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])
  items         OrderItem[]
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  unit      String    @default("pcs")
  price     Int
  subtotal  Int
  note      String?
  startDate DateTime?
  endDate   DateTime?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      BillingPlan
  status    SubscriptionStatus @default(ACTIVE)
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BillingTransaction {
  id                    String        @id @default(cuid())
  userId                String
  plan                  BillingPlan
  amount                Int
  status                BillingStatus @default(PENDING)
  midtransOrderId       String        @unique
  midtransTransactionId String?       @unique
  snapToken             String?
  snapRedirectUrl       String?
  paymentReference      String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  STAFF
  PELANGGAN
}

enum OrderStatus {
  BARU
  DIPROSES
  DIKIRIM
  SELESAI
  BATAL
}

enum ItemType {
  BARANG
  JASA
  SEWA
}

enum PaymentMethod {
  TRANSFER
  COD
  TUNAI
  QRIS
}

enum PaymentStatus {
  BELUM_BAYAR
  LUNAS
}

enum BillingPlan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum BillingStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}
